{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": "./apps/agropulse",
    "paths": {
      "react": [
        "./node_modules/@types/react",
        "./node_modules/react"
      ],
      "react-native": [
        "./node_modules/@types/react-native",
        "./node_modules/react-native"
      ],
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    },
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "apps/agropulse/**/*.ts",
    "apps/agropulse/**/*.tsx"
  ]
}
